# ==============================================================================
# FIGUREDIT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME (SERVER-SIDE)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Set to "true" only if you explicitly want zero-credential demo mode active in production.
# Defaults to "false" (fail-closed security when Supabase credentials are missing).
ALLOW_PRODUCTION_DEMO="false"

# APP_URL: The public canonical URL where this application is hosted.
APP_URL="https://figuredit.in"

# RESEND_API_KEY: Server-only key for analysis completion emails; verify figuredit.in in Resend first.
RESEND_API_KEY=""

# Public contact address shown on the site; defaults to hello@figuredit.in if unset.
VITE_CONTACT_EMAIL="hello@figuredit.in"

# Keep paid plans on the waitlist until Dodo products, webhook and credentials are live.
VITE_BILLING_ENABLED="false"

# Dodo Payments server credentials. Keep the API key and webhook secret on Render only.
DODO_PAYMENTS_API_KEY=""
DODO_WEBHOOK_SECRET=""
# Use test_mode with test products, then live_mode with live products.
DODO_ENVIRONMENT="test_mode"
# Dodo subscription product IDs, separately created in the selected environment.
DODO_PRODUCT_STARTER_MONTHLY=""
DODO_PRODUCT_STARTER_YEARLY=""
DODO_PRODUCT_PRO_MONTHLY=""
DODO_PRODUCT_PRO_YEARLY=""

# ------------------------------------------------------------------------------
# 2. GEMINI AI CONFIGURATION (SERVER-SIDE SECRET ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key used for company intelligence & strategic analysis.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Production company analysis uses Gemini, with optional Azure OpenAI fallback.
COMPANY_ANALYSIS_PROVIDER="gemini"

# Stable default; override only with another production model available to this API key.
GEMINI_MODEL="gemini-3.5-flash"
COMPANY_ANALYSIS_TIMEOUT_MS="30000"

# Optional Azure OpenAI fallback; enabled only when all four settings are present.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION=""

# Maximum number of company analyses a user may request per UTC day (server enforced).
AI_DAILY_COMPANIES_PER_USER="200"

# ------------------------------------------------------------------------------
# 3. SUPABASE PUBLIC / BROWSER CONFIGURATION (BUNDLED WITH VITE CLIENT)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anonymous API key (safe for browser client)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVER-SIDE PRIVILEGED CONFIGURATION (SERVER-SIDE SECRET ONLY)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY: Administrative service role key for server operations.
# CRITICAL: NEVER prefix with VITE_ and NEVER expose in browser bundles.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server error reporting. Keep this and all Sentry credentials on Render only.
SENTRY_DSN=""
# Browser error reporting DSN; VITE_ values are public in the built bundle.
VITE_SENTRY_DSN=""
# Optional source-map upload at build time. Set all three in Render to enable it.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Render supplies this automatically; used as the Sentry release for client and server.
RENDER_GIT_COMMIT=""

# Honeybadger Check-In report URL (secret); create a Simple check-in for the worker.
HONEYBADGER_CHECKIN_URL=""

# Clear contact rows and raw CSV row copies after 1-90 days; default 90. Worker checks hourly.
DATA_RETENTION_DAYS="90"

# Disable public-website enrichment only when needed; enabled by default.
COMPANY_WEBSITE_ENRICHMENT_ENABLED="true"

# Local Vite option; true disables HMR and file watching.
DISABLE_HMR="false"

# Optional live acceptance-test settings (not used by the production app).
ICP_LIVE_TEST_PROJECT_REF=""
ICP_ACCEPTANCE_APP_URL="https://figuredit.in"
