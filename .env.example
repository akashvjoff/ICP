# ==============================================================================
# FIGUREDIT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME (SERVER-SIDE)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Set to "true" only if you explicitly want zero-credential demo mode active in production.
# Defaults to "false" (fail-closed security when Supabase credentials are missing).
ALLOW_PRODUCTION_DEMO="false"

# APP_URL: The public canonical URL where this application is hosted.
APP_URL="https://figuredit.in"

# Public contact address shown on the site; defaults to hello@figuredit.in if unset.
VITE_CONTACT_EMAIL="hello@figuredit.in"

# ------------------------------------------------------------------------------
# 2. GEMINI AI CONFIGURATION (SERVER-SIDE SECRET ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key used for company intelligence & strategic analysis.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# AI Provider: "gemini" (production default), "mock" (offline test), or "ollama" (local LLM).
COMPANY_ANALYSIS_PROVIDER="gemini"

# Optional model override (e.g., "gemini-2.5-flash"). If blank, auto-discovers optimal available model.
GEMINI_MODEL=""
COMPANY_ANALYSIS_TIMEOUT_MS="30000"

# Optional local Ollama settings (for local development only)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL=""

# ------------------------------------------------------------------------------
# 3. SUPABASE PUBLIC / BROWSER CONFIGURATION (BUNDLED WITH VITE CLIENT)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anonymous API key (safe for browser client)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVER-SIDE PRIVILEGED CONFIGURATION (SERVER-SIDE SECRET ONLY)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY: Administrative service role key for server operations.
# CRITICAL: NEVER prefix with VITE_ and NEVER expose in browser bundles.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
